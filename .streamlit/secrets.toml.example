# Copy to secrets.toml (gitignored) for local runs, or paste into
# Streamlit Cloud → App settings → Secrets.
# Never commit secrets.toml or a downloaded service-account JSON key.

sheet_id = "the-long-id-from-the-sheet-url"
worksheet = "calls"

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-app@your-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
